# Staging backend — copy to .env on deploy host
DATABASE_URL="postgresql://USER:PASS@HOST:5432/cs2_p2p_mvp?schema=public"
PORT=3000
JWT_SECRET="replace-with-strong-random-secret"
JWT_EXPIRES_IN="7d"
FRONTEND_ORIGIN="https://staging.example.com"

# --- Phase 1: crypto deposits (scripts/enable-crypto-payments-staging.sh) ---
PAYMENT_PROVIDER=crypto_tron
CRYPTO_GATEWAY_URL=http://127.0.0.1:3001
CRYPTO_GATEWAY_API_KEY=replace-with-gateway-api-key
CRYPTO_GATEWAY_WEBHOOK_SECRET=replace-with-webhook-secret
ENABLE_MOCK_DEPOSIT=false
MIN_DEPOSIT_MINOR=500
MIN_WITHDRAW_MINOR=2000
WITHDRAW_FEE_MINOR=200
WITHDRAW_MANUAL_REVIEW=true
WITHDRAW_MANUAL_REVIEW_COUNT=3
WITHDRAW_REQUIRE_STEAM_LINKED=true
WITHDRAW_DAILY_CAP_MINOR=50000

# --- Steam (p2pcs default) ---
AUTH_PROVIDER=steam
INVENTORY_PROVIDER=steam
TRADE_PROVIDER=mock
ENABLE_MOCK_TRADE=true
ENABLE_TEST_ROUTES=false
STEAM_OPENID_REALM=https://staging.example.com
STEAM_WEB_API_KEY=
# STEAM_HTTP_PROXY=http://user:pass@proxy:port

# --- Phase 2: scripts/enable-phase2-shadow-trade-staging.sh ---
# TRADE_PROVIDER=steam
# TRADE_VERIFICATION_MODE=shadow
# ENABLE_REAL_SETTLEMENT=false
# ENABLE_EXTENSION_CHANNEL=true
# ENABLE_EXTENSION_TASK_PIPELINE=true
# ENABLE_DELIVERY_VERIFICATION_ENGINE=true
# ENABLE_EXTENSION_FLOW_OBSERVABILITY=true

# --- Phase 2b: scripts/enable-phase2-live-trade-staging.sh ---
# TRADE_VERIFICATION_MODE=live
# ENABLE_MOCK_TRADE=false

# --- Phase 3: scripts/enable-phase3-settlement-staging.sh ---
# ENABLE_REAL_SETTLEMENT=true
# ENABLE_SETTLEMENT_HOLD_WINDOW=true
# STEAM_SETTLEMENT_ALLOWLIST_STEAM_IDS=76561198...,76561198...
# STEAM_SETTLEMENT_MAX_ORDER_MINOR=5000
# STEAM_SETTLEMENT_MAX_DAILY_ORDERS=3
# STEAM_SETTLEMENT_MAX_DAILY_VOLUME_MINOR=15000

# Full rollout guide: docs/REAL-MONEY-ROLLOUT.md
