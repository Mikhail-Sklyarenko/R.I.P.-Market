# Server-only secrets (never commit backend/.env.secrets).
# Copy to backend/.env.secrets on the VPS and restrict: chmod 600 backend/.env.secrets
#
# Configure:
#   STEAM_HTTP_PROXY='http://LOGIN:PASSWORD@gw.dataimpulse.com:823' \
#     bash scripts/configure-steam-proxy-staging.sh

# Residential HTTP proxy for all server-side Steam egress (OpenID, inventory, trade poll, prices).
STEAM_HTTP_PROXY=http://LOGIN:PASSWORD@gw.dataimpulse.com:823

# Route api.steampowered.com (trade poll, GetPlayerSummaries) through proxy on staging VPS.
STEAM_HTTP_PROXY_ALL=true
